# Copy to `.env` and edit. `.env` is gitignored - never commit real keys.
# Every RA_* setting has a safe default (see README Configuration table);
# only set what you're changing.

# --- judge / generation backend ------------------------------------------
# stub (default, free, deterministic) | ollama (local, free) | anthropic | gemini
RA_JUDGE_BACKEND=stub
RA_JUDGE_MODEL=

# ollama backend - nothing leaves the machine, no key needed
# RA_JUDGE_BACKEND=ollama
# RA_JUDGE_MODEL=qwen2.5:7b-instruct
# RA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# RA_OLLAMA_TIMEOUT_SECONDS=300
# RA_OLLAMA_NUM_CTX=8192

# hosted backends - pick one, never commit the key
# RA_JUDGE_BACKEND=anthropic
# RA_JUDGE_MODEL=claude-sonnet-5
# RA_ANTHROPIC_API_KEY=

# RA_JUDGE_BACKEND=gemini
# RA_JUDGE_MODEL=gemini-2.5-flash
# RA_GEMINI_API_KEY=

# --- retrieval backend ----------------------------------------------------
# auto (default: probe Track A, fall back to stub) | stub | track_a
RA_RETRIEVAL_BACKEND=auto

# --- agent graph / MCP ------------------------------------------------------
# RA_TOOL_DEADLINE_SECONDS=10
# RA_MAX_REWRITES=3
# RA_MAX_RE_RETRIEVALS=2

# --- observability (optional) -----------------------------------------------
# RA_TRACING_ENABLED=false
# RA_LANGFUSE_PUBLIC_KEY=
# RA_LANGFUSE_SECRET_KEY=
